          "name": "Search properties via GIS",
          "request": {
            "name": "Search properties via GIS",
            "description": {
              "content": "Performs a geographic information system search for properties within a specified region. Returns property listings matching the provided filters including price range, property type, bedroom and bathroom counts, and geographic boundaries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "do",
                "gis-search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "region_id",
                  "value": "<integer>",
                  "description": "The unique identifier for a Redfin region."
                },
                {
                  "disabled": false,
                  "key": "region_type",
                  "value": "<integer>",
                  "description": "The type of region to search. Values include 1 (neighborhood), 2 (ZIP code), 5 (county), 6 (city)."
                },
                {
                  "disabled": false,
                  "key": "uipt",
                  "value": "<string>",
                  "description": "Property type filter. Values include 1 (house), 2 (condo), 3 (townhouse), 4 (multi-family), 5 (land), 6 (other). Multiple values can be comma-separated."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<integer>",
                  "description": "Listing status filter. Values include 1 (active), 130 (pending), 131 (active and pending)."
                },
                {
                  "disabled": false,
                  "key": "min_price",
