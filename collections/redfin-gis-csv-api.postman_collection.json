  "info": {
    "_postman_id": "9587b8a8-a483-475a-9ecf-8b01a1038218",
    "name": "Redfin GIS CSV Export API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Redfin GIS CSV Export API provides bulk property data downloads in CSV format. This endpoint returns up to 350 property records per request in tabular format, making it suitable for data analysis and spreadsheet workflows. It accepts parameters for market selection, price ranges, bedroom and bathroom counts, region identifiers, and property status filters. The CSV output includes fields such as address, list price, property type, square footage, lot size, and listing status, enabling developers and analysts to aggregate property data for research and comparison purposes.\n\nContact Support:\n Name: Redfin",
      "type": "text/plain"
    }
  }
